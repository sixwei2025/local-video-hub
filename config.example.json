    {
      "line": "wenzhe",
      "match": "产线F-文哲|文学哲学|文哲"
    },
    {
      "line": "lab",
      "match": "产线G-实验室|/lab/|视频大杂烩"
    }
  ],
  "kind_rules": {
    "_说明": "命中 draft 正则的视为草稿（片段/中间产物），其余为成片",
    "draft": "/_qc|/qc_|_redo|/tmp|/temp|/segments?/|/scenes?/|/clips?/|/parts?/|/shots?/|/frames?/|/staging/|/uploads/|/work/|/build/|/raw/|/audio/|草稿|draft|seg_?\\d|scene_?\\d|clip_?\\d|part_?\\d|shot_?\\d|_silent|_nobgm|_noaudio|_v\\d+_tmp|/镜/|镜\\d+|成片_无声|(^|[-_/])lo([-_.]|$)|(^|[-_/])seg([-_.\\d]|$)|[-_]preview|sample_\\d|/assets/|/src/|/(body|orig)\\.mp4$",
    "fragment": {
      "_说明": "成片之外的碎片（分段/镜头/无声版/测试/中间产物/叠加或封面合成草稿/过短）不进网站；已发布、精选、风格小样、hub.py submit 提交的作品豁免",
      "min_duration": 8,
      "name_regex": "(^|[-_./ ])(segments?|clips?|shots?|scenes?|seg|parts?|tmp|temp|test|preview|body|orig|overlay|nosub|silent|mute|intermediate|comp_?draft)([-_. \\d]|$)|镜\\d*|分镜|片段|无声|无字幕|叠加|封面合成|测试",
      "no_audio_ratio": 0.5,
      "exempt": [
        "published",
        "featured",
        "style_sample",
        "hub_submit"
      ]
    }
  },
  "status_rules": {
